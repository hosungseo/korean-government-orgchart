{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "직제 기구도 · 한글 편집본",
  "version": "0.3.0",
  "identifier": "kr.orgchart.government.nativehwpx",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "직제 기구도 · 한글 편집본",
        "width": 1380,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
